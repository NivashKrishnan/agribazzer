# AGRIBAZZER Full-Stack Environment Configuration

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Database Connection
# For Local Development (SQLite fallback):
DATABASE_URL=server/agribazzer.sqlite
# For Production (PostgreSQL / Neon / Render):
# DATABASE_URL=postgres://agribazzer_user:password@ep-cool-db.us-east-2.aws.neon.tech/agribazzer?sslmode=require

# Authentication & Security
SESSION_SECRET=agribazzer_production_jwt_secret_change_in_production_32chars
CORS_ORIGIN=https://agribazzer.vercel.app,http://localhost:5173,capacitor://localhost

# Frontend Client Environment Variable (Vercel / Local)
# In production on Vercel, set this to your Render backend URL (e.g. https://agribazzer-backend.onrender.com)
VITE_API_BASE_URL=http://localhost:5000

# External AI & Weather Integrations (Backend Only - Never expose to client)
GEMINI_API_KEY=your_gemini_api_key_here
WEATHER_API_KEY=your_weatherapi_key_here
AGMARKNET_API_KEY=your_agmarknet_or_data_gov_key_here
